# ============================================================================
# Marine Debris Sonar AI — environment configuration
# Copy to .env (Gitignored) and adjust. All values have safe defaults.
# ============================================================================

# --- Paths ---
# Root for ALL runtime artifacts (uploads, artifacts, reports, exports, db, tmp)
DATA_ROOT=./data
# Model registry + weights location
MODELS_DIR=./models
# Which registry entry serves by default (must exist in models/registry.json)
# Leave empty to use the registry's single "active" entry; degraded mode if none.
ACTIVE_MODEL_VERSION=

# --- Inference ---
# auto | cpu | cuda   (MVP guarantee: cpu always works)
DEVICE=auto
# Serving defaults; per-request overrides allowed within bounds
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
# Below this the API refuses per-request threshold overrides (safety floor)
MIN_CONFIDENCE_OVERRIDE=0.05

# --- Uploads / security ---
MAX_UPLOAD_MB=100
# Comma-separated allowlist (validated against extension AND magic bytes)
ALLOWED_EXTENSIONS=png,tif,tiff,jpg,jpeg,zip
CORS_ORIGINS=http://localhost:5173

# --- Persistence ---
# false = file-backed JSON manifests under DATA_ROOT/db (MVP default)
MONGODB_ENABLED=false
MONGODB_URL=mongodb://localhost:27017

# --- Jobs (in-process; survey batches & reports) ---
# Surveys with more images than this run as background jobs (OPEN decision #7)
ASYNC_SURVEY_THRESHOLD=25

# --- Logging ---
LOG_LEVEL=INFO
