# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Node ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- Runtime artifacts (single root, relocatable via DATA_ROOT) ---
data/uploads/*
data/artifacts/*
data/reports/*
data/exports/*
data/db/*
data/tmp/*
# Pre-purge runtime snapshots kept on disk for reference, not versioned
# alongside live state.
data/db_backup_*/
!data/uploads/.gitkeep
!data/artifacts/.gitkeep
!data/reports/.gitkeep
!data/exports/.gitkeep
!data/db/.gitkeep
!data/tmp/.gitkeep

# --- Model weights (registry.json IS tracked; payloads are not) ---
models/weights/*
!models/weights/.gitkeep
# Any other checkpoint anywhere (incl. the third-party COCO base weights
# yolov8n.pt / yolov8s.pt downloaded at the repo root). Never commit weights.
*.pt
*.onnx

# --- Runtime logs (regenerated by every dev run) ---
*.log

# --- Dataset payloads (manifests in datasets/manifests/ ARE tracked) ---
datasets/raw/*
datasets/interim/*
datasets/processed/*
!datasets/raw/.gitkeep
!datasets/interim/.gitkeep
!datasets/processed/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Playwright ---
e2e/test-results/
e2e/playwright-report/
